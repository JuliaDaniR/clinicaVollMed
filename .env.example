# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO — Voll Med API
# Copia este archivo como .env y completa los valores
# ============================================================

# ============================================================
# BASE DE DATOS
# LOCAL: usa jdbc:mysql://localhost:3306/vollmed-api?createDatabaseIfNotExist=true
# RENDER (Aiven): usa la URL que te da Aiven en el panel
# ============================================================
VOLLMED_DB_URL=jdbc:mysql://<host-aiven>:<puerto>/vollmed-api?createDatabaseIfNotExist=true&ssl-mode=REQUIRED
VOLLMED_DB_USER=<usuario-aiven>
VOLLMED_DB_PASS=<password-aiven>

# ============================================================
# SEGURIDAD / JWT
# Genera un secreto largo y aleatorio (mínimo 64 chars)
# ============================================================
JWT_SECRET=<tu-secreto-jwt-largo-y-seguro>

# ============================================================
# MAILTRAP (envío de emails)
# ============================================================
MAILTRAP_USER=<usuario-mailtrap>
MAILTRAP_PASS=<password-mailtrap>

# ============================================================
# IA — OpenRouter
# ============================================================
OPENROUTER_API_KEY=<tu-api-key-openrouter>

# ============================================================
# IA — Google Gemini
# ============================================================
GEMINI_API_KEY=<tu-api-key-gemini>

# ============================================================
# CORS — URLs permitidas (separadas por coma)
# LOCAL: http://localhost:5173
# RENDER: https://<tu-frontend>.onrender.com
# ============================================================
CORS_ALLOWED_ORIGINS=https://<tu-frontend>.onrender.com
